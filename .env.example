# =============================================================================
# Vitrina: plantilla de variables de entorno
# Copia este archivo a `.env` y ajusta los valores. `.env` nunca se sube al repo.
# src/lib/env.ts valida todo al arrancar y falla con un mensaje claro si algo falta.
# =============================================================================

APP_ENV=development
# Dirección pública de la app (enlaces de correos, catálogo y WhatsApp)
APP_URL=http://localhost:4200

# PostgreSQL de docker-compose.yml.
# La app usa el rol app_runtime (sin permisos de dueño ni BYPASSRLS, ADR-0002).
DATABASE_URL=postgres://app_runtime:solo-desarrollo@localhost:54320/vitrina
# Migraciones y datos de ejemplo usan el dueño del esquema.
DATABASE_OWNER_URL=postgres://vitrina_owner:solo-desarrollo@localhost:54320/vitrina
DATABASE_TEST_URL=postgres://vitrina_owner:solo-desarrollo@localhost:54320/vitrina_test
# La misma base de pruebas, pero con el rol de la app: así las pruebas ejercen la seguridad por fila
DATABASE_TEST_RUNTIME_URL=postgres://app_runtime:solo-desarrollo@localhost:54320/vitrina_test

# Sesiones (Better Auth). Genera uno con: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=cambia-esto-por-un-valor-aleatorio-de-32-bytes

# Correos de las personas que administran la plataforma, separados por coma
ADMIN_EMAILS=admin@vitrina.test

# Correo de salida. En desarrollo, Mailpit (http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Vitrina <no-responder@vitrina.test>

# Imágenes en SeaweedFS de docker-compose.yml (S3 compatible; en producción, Cloudflare R2)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=vitrina-imagenes
S3_ACCESS_KEY=vitrina
S3_SECRET_KEY=solo-desarrollo
S3_PUBLIC_URL=http://localhost:8333/vitrina-imagenes

# Entrar con Google (opcional). Sin estas dos, el botón de Google no aparece.
# Se crean en Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
