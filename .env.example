# =============================================================================
# Vitrina: environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) and fill values for your machine.
# NEVER commit a real `.env`. Only this template is tracked.
#
# Runtime validation of these variables (via Zod, in `src/lib/env.ts`) is
# introduced in Sprint 1.2. No variable is added here until a sprint needs it.
#
# Environment profiles: development | test | staging | production
# =============================================================================

# Environment profile the app runs under.
APP_ENV=development
