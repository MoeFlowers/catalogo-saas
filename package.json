{
  "name": "vitrina",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vitrina: catálogos en línea con pedidos por WhatsApp para empresas.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.11.0 <23.0.0",
    "pnpm": ">=10 <11"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "next dev --port 4200",
    "build": "next build",
    "start": "next start --port 4200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx --env-file=.env scripts/migrar.ts",
    "db:semilla": "tsx --env-file=.env scripts/semilla.ts",
    "db:reiniciar": "tsx --env-file=.env scripts/reiniciar.ts",
    "db:migrar:ci": "tsx scripts/migrar.ts && tsx scripts/migrar.ts --test"
  }
}
